\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Real-time entropy telemetry of Llama-3.1-8B executing on an NVIDIA RTX 5090 Blackwell workstation (538 generation steps at $50.13\text  { tok/s}$), generated under a structurally constrained poetic prompt. \textbf  {Top:} Output distribution Shannon entropy $H(t)$ in bits/token against dual Schmitt-trigger hysteresis thresholds ($\theta _{\text  {low}}=0.55$, $\theta _{\text  {high}}=1.25$). \textbf  {Bottom:} Clutch state $k(t)$ as computed from live entropy. \textit  {This run uses single-model cached decoding; the clutch's $k(t)$ decision is logged for diagnostic purposes but does not yet branch execution, so the $50.13\text  { tok/s}$ figure reflects baseline generation speed, not accelerated speculative decoding. See Section~\ref {sec:integration_gap}.}}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:telemetry_trace}{{1}{2}{Real-time entropy telemetry of Llama-3.1-8B executing on an NVIDIA RTX 5090 Blackwell workstation (538 generation steps at $50.13\text { tok/s}$), generated under a structurally constrained poetic prompt. \textbf {Top:} Output distribution Shannon entropy $H(t)$ in bits/token against dual Schmitt-trigger hysteresis thresholds ($\theta _{\text {low}}=0.55$, $\theta _{\text {high}}=1.25$). \textbf {Bottom:} Clutch state $k(t)$ as computed from live entropy. \textit {This run uses single-model cached decoding; the clutch's $k(t)$ decision is logged for diagnostic purposes but does not yet branch execution, so the $50.13\text { tok/s}$ figure reflects baseline generation speed, not accelerated speculative decoding. See Section~\ref {sec:integration_gap}.}}{figure.1}{}}
